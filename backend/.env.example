# Database
DATABASE_URL="postgresql://username:password@localhost:5432/claps_learn_erp?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# WhatsApp API (optional - for future integration)
WHATSAPP_API_KEY=""
WHATSAPP_API_URL=""

# Email (optional - for future integration)
EMAIL_SERVICE=""
EMAIL_USER=""
EMAIL_PASSWORD=""

# Cron Jobs
ENABLE_CRON_JOBS="true"

# Logging
LOG_LEVEL="info"
